{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"SCOUTSUNITE_PHOTOS_DOSSIER": "/photos-privees"
			}
		},
		{
			"step": "setSiteLanguage",
			"language": "fr_FR"
		},
		{
			"step": "activateTheme",
			"themeFolderName": "les-scouts-unite"
		},
		{
			"step": "activatePlugin",
			"pluginPath": "les-scouts-unite-extension/les-scouts-unite-extension.php"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Mon unité",
				"blogdescription": "Unité scoute de Localité",
				"permalink_structure": "/%postname%/",
				"timezone_string": "Europe/Brussels",
				"date_format": "j F Y"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-content/themes/les-scouts-unite/playground/contenu-demo.php';"
		}
	]
}
