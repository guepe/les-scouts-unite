<?xml version="1.0"?>
<ruleset name="les-scouts-unite">
	<description>Règles de sécurité de WordPress pour le thème (échappement, nonces, données reçues, SQL).</description>

	<file>functions.php</file>
	<file>inc</file>
	<file>patterns</file>
	<!-- Bibliothèque des QR codes, copiée telle quelle. -->
	<exclude-pattern>inc/lib/*</exclude-pattern>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<!-- Renvoie déjà une adresse passée par esc_url(). -->
			<property name="customEscapingFunctions" type="array">
				<element value="scoutsunite_image"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.Security.NonceVerification"/>
	<rule ref="WordPress.Security.ValidatedSanitizedInput"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
</ruleset>
